<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_form_inherit_sprint" model="ir.ui.view">
        <field name="name">project.task.form.inherit.sprint</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                    <field name="sprint" domain="[('project_id', '=', project_id)]" context="{'project_id': project_id}"/>                    
                    <field name="parent_id"
                        domain="[('project_id', '=', project_id), ('parent_id', '=', False)]"
                        invisible="subtask_count > 0"/>
            </xpath>            
        </field>
    </record>
</odoo>
