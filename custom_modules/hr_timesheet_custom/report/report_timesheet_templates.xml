<odoo>

    <template id="report_timesheet_custom" inherit_id="hr_timesheet.timesheet_table">
		<xpath expr="//table[hasclass('table','table-sm')]" position="replace">
			<table class="table table-borderless mb-0">
				<thead style="display: table-row-group">
					<tr>
						<t t-set="timesheet_record_label" t-value="False"/>
						<t t-if="show_task">
							<t t-set="timesheet_record_label">Tarea</t>
						</t>
						<t t-elif="show_project">
							<t t-set="timesheet_record_label">Proyecto</t>
						</t>
						<th class="text-start align-middle"><span style="color: #000000; !important">Fecha</span></th>
						<th class="text-start align-middle"><span style="color: #000000; !important">Responsable</span></th>
						<th class="text-start align-middle"><span style="color: #000000; !important">Descripción</span></th>
						<th class="text-start align-middle"><span style="color: #000000; !important">Tarea</span></th>
						<th class="text-end">
							<span style="color: #000000; !important" t-if="not is_uom_day">Tiempo dedicado (Horas)</span>
							<span style="color: #000000; !important" t-else="">Tiempo dedicado (Dias)</span>
						</th>
					</tr>
				</thead>
				<tbody>
				<t t-set="total_planned_hours" t-value="docs.get_report_timesheet_custom()"/>
				<tr t-foreach="lines" t-as="line">
					<td>
						<span t-field="line.date"/>
					</td>
					<td>
						<span t-field="line.user_id.partner_id.name"/>
						<span t-if="not line.user_id.partner_id.name" t-field="line.employee_id"/>
					</td>
					<td >
						<span t-field="line.name" t-options="{'widget': 'text'}"/>
					</td>
					<td t-if="show_project">
						<span t-field="line.project_id.sudo().name"/>
					</td>
					<td t-if="show_task">
						<t t-if="line.task_id"><span t-field="line.task_id.sudo().name"/></t>
					</td>
					<td class="text-end">
						<span t-if="is_uom_day" t-esc="line._get_timesheet_time_day()" t-options="{'widget': 'timesheet_uom'}"/>
						<span t-else="" t-field="line.unit_amount" t-options="{'widget': 'duration', 'digital': True, 'unit': 'hour', 'round': 'minute'}"/>
					</td>
				</tr>

				<tr>
					<t t-set="nbCols" t-value="4"/>
					<t t-if="show_project" t-set="nbCols" t-value="nbCols + 1"/>
					<t t-if="show_task" t-set="nbCols" t-value="nbCols + 1"/>
					<td class="text-end" t-attf-colspan="{{nbCols}}">
						<strong t-if="is_uom_day">
							<span style="margin-right: 15px; color: #000000; !important">Horas consumidas (Dias)</span>
							<span style="color: #000000; !important"><t t-esc="lines._convert_hours_to_days(sum(lines.mapped('unit_amount')))" t-options="{'widget': 'timesheet_uom'}"/></span>
						</strong>
						<strong t-else="">
							<span style="margin-right: 15px; color: #000000; !important">Horas consumidas (Horas)</span>
							<span style="color: #000000; !important"><t t-esc="sum(lines.mapped('unit_amount'))" t-options="{'widget': 'duration', 'digital': True, 'unit': 'hour', 'round': 'minute'}"/></span>
						</strong>
					</td>
				</tr>

				<tr>
					<t t-set="nbCols" t-value="4"/>
					<t t-if="show_project" t-set="nbCols" t-value="nbCols + 1"/>
					<t t-if="show_task" t-set="nbCols" t-value="nbCols + 1"/>
					<td class="text-end" t-attf-colspan="{{nbCols}}">
						<strong t-if="is_uom_day">
							<span style="margin-right: 15px; color: #000000; !important">Horas contratadas (Dias)</span>
							<span style="color: #000000; !important"><t t-esc="lines._convert_hours_to_days(total_planned_hours['planned_hours'])" t-options="{'widget': 'timesheet_uom'}"/></span>
						</strong>
						<strong t-else="">
							<span style="margin-right: 15px; color: #000000; !important">Horas contratadas (Horas)</span>
							<span style="color: #000000; !important"><t t-esc="total_planned_hours['planned_hours']" t-options="{'widget': 'duration', 'digital': True, 'unit': 'hour', 'round': 'minute'}"/></span>
						</strong>
					</td>
				</tr>

				<tr>
					<t t-set="nbCols" t-value="4"/>
					<t t-if="show_project" t-set="nbCols" t-value="nbCols + 1"/>
					<t t-if="show_task" t-set="nbCols" t-value="nbCols + 1"/>
					<td class="text-end" t-attf-colspan="{{nbCols}}">
						<t t-set="resta" t-value="total_planned_hours['planned_hours'] - sum(docs.mapped('unit_amount'))" />
						<strong t-if="is_uom_day">
							<span style="margin-right: 15px; color: #000000; !important">Horas restantes (Dias)</span>
							<span style="color: #000000; !important"><t t-esc="lines._convert_hours_to_days(resta)*-1" t-options="{'widget': 'timesheet_uom'}"/></span>
						</strong>
						<strong t-else="">
							<span style="margin-right: 15px; color: #000000; !important">Horas restantes (Horas)</span>
							<span style="color: #000000; !important"><t t-esc="resta" t-options="{'widget': 'duration', 'digital': True, 'unit': 'hour', 'round': 'minute'}"/></span>
						</strong>
					</td>
				</tr>

			</tbody>
		</table>
		</xpath>
	</template>

	<template id="report_timesheet_custom_layout" inherit_id="hr_timesheet.report_timesheet">
		<xpath expr="//t[@t-call='web.internal_layout']" position="replace">		
            <t t-call="web.external_layout_striped">
				<t t-set="company" t-value="docs.project_id.company_id if len(docs.project_id) == 1 else docs.env.company"/>
                <t t-set="show_task" t-value="bool(docs.task_id)"/>
                <t t-set="show_project" t-value="len(docs.project_id) > 1"/>
                <div class="page">
                    <div class="oe_structure"/>
                    <div class="row mt8">
                        <div class="col-lg-12">
                            <h2>
                                <span style="color: #000000; !important">Detalle de los partes de horas
                                    <t t-if="len(docs.project_id) == 1">
                                        para <t t-out="docs.project_id.name">Research and Development</t> Proyecto
                                    </t>
                                </span>
                            </h2>
                        </div>
                    </div>
                    <t t-set='lines' t-value='docs'/>
                    <t t-call="hr_timesheet.timesheet_table"/>
                    <div class="oe_structure"/>
                </div>
			</t>		
		</xpath>
	</template>
	
</odoo>