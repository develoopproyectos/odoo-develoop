<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
        <xpath expr="//th[@name='th_subtotal']" position="before">
            <t t-set="is_consu" t-value="any(l.product_id.detailed_type == 'consu' for l in doc.order_line)"/>
                <th name="th_quantity" class="text-end" t-if="is_consu">Quantity</th>
                <th name="th_priceunit" class="text-end" t-if="is_consu">Unit Price</th>                
        </xpath>
        <xpath expr="//tbody//td[@name='td_subtotal']" position="before">
            <t t-set="is_consu" t-value="any(l.product_id.detailed_type == 'consu' for l in doc.order_line)"/>
            <t t-if="line.product_id.detailed_type == 'consu'">
                <td name="td_quantity" class="text-end" >
                    <span t-field="line.product_uom_qty"/>
                    <span t-field="line.product_uom"/>
                </td>
                <td name="td_priceunit" class="text-end">
                    <span t-field="line.price_unit"/>
                </td>
            </t>          
            <t t-elif="is_consu">
                <td name="td_quantity" class="text-end" >
                    
                </td>
                <td name="td_priceunit" class="text-end">
                    
                </td>
            </t>            
            <t t-else="">
            </t>
                
        </xpath>
    </template>
</odoo>