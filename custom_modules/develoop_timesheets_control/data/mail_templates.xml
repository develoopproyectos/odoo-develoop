<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
    
        <!-- Aviso amistoso del martes -->
        <record id="mail_template_timesheet_reminder" model="mail.template">
            <field name="name">Aviso del Martes (Recordatorio Amistoso)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">Recordatorio: Parte de horas de la semana pasada incompleto</field>
            <field name="email_to">{{ object.work_email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hola <t t-out="object.name"/>,</p>

                    <p>
                        Revisando los registros de la semana pasada hemos detectado
                        que te has olvidado de imputar horas en tu parte
                        <span>
                            (días pendientes:
                            <t t-out="len(ctx.get('Dias_Faltantes', []))"/>)
                        </span>.
                        Por favor, cuando tengas un momento a lo largo del día de hoy,
                        complétalo para llevar el registro al día.
                    </p>

                    <p>¡Muchas gracias y a por el martes!</p>

                    <p>
                        <strong>Semana revisada:</strong>
                        <t t-out="ctx.get('Semana_Anterior')"/>
                    </p>

                    <table border="1" cellpadding="5" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Horas imputadas</th>
                                <th>Horas pendientes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="ctx.get('Dias_Faltantes', [])" t-as="day">
                                <td><t t-out="day['fecha']"/></td>
                                <td><t t-out="'%.2f' % day['horas_imputadas']"/> h</td>
                                <td><t t-out="'%.2f' % day['horas_pendientes']"/> h</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
        </record>

        <!-- Recordatorio urgente del viernes -->
        <record id="mail_template_timesheet_urgent" model="mail.template">
            <field name="name">Aviso del Viernes (Recordatorio Directo y Urgente)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">URGENTE: Parte de horas de la semana pasada SIN CERRAR</field>
            <field name="email_to">{{ object.work_email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hola <t t-out="object.name"/>,</p>

                    <p>
                        Llegamos a final de semana y seguimos detectando los siguientes días sin imputar en tu parte de horas de la semana pasada: <strong>(<t t-out="len(ctx.get('Dias_Faltantes', []))"/>)</strong>
                    </p>
                    <p>
                        Es <strong>estrictamente necesario e imprescindible</strong> que dejes esto resuelto hoy mismo. No tener el parte de horas al día bloquea los cierres de facturación y el seguimiento de los proyectos.
                        Por favor, paraliza lo que estés haciendo y actualízalo inmediatamente. Gracias."
                    </p>

                    <p>
                        <strong>Semana revisada:</strong>
                        <t t-out="ctx.get('Semana_Anterior')"/>
                    </p>

                    <table border="1" cellpadding="5" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Horas imputadas</th>
                                <th>Horas pendientes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="ctx.get('Dias_Faltantes', [])" t-as="day">
                                <td><t t-out="day['fecha']"/></td>
                                <td><t t-out="'%.2f' % day['horas_imputadas']"/> h</td>
                                <td><t t-out="'%.2f' % day['horas_pendientes']"/> h</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
        </record>
    </data>
</odoo>
