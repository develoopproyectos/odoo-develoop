<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="planning_slot_view_form_custom" model="ir.ui.view">
        <field name="name">planning.slot.form.custom</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allocated_hours']" position="after">
                <field name="x_check_change_all" />
                <field name="x_expiration_date" string="Fecha límite" />
            </xpath>
            <xpath expr="//field[@name='role_id']" position="before">
                <field name="resource_ids" string="Recursos" widget="many2many_tags" />
            </xpath>
        </field>
    </record>

    <record id="planning_forecast_inherit" model="ir.ui.view">
        <field name="name">planning.slot.custom.view.form</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="project_forecast.planning_slot_view_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='task_id']" position="attributes">
                    <!-- <attribute name="domain">[('project_id', '=', project_id),('stage_id.name', 'in', ['Planificación','Planificacion','En desarrollo','Desarrollo','Validación QA','QA'])]</attribute> -->
                    <attribute name="domain">[('project_id', '=', project_id),'|',
                        '|',('stage_id.name', 'ilike', 'qa'),('stage_id.name', 'ilike', 'desarrollo'),('stage_id.name', 'ilike', 'planifi')]
                    </attribute>                    
                </xpath>
            </data>
        </field>
    </record>

    <record id="planning_view_gantt_custom" model="ir.ui.view">
        <field name="name">planning.slot.gantt</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_gantt"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allocated_hours']" position="after">
                <field name="x_expiration_date" />
                <field name="x_kanban_state" />
                <field name="x_stage_id" />
            </xpath>
        </field>
    </record>

</odoo>