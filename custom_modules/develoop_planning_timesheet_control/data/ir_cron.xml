<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_check_weekly_timesheets" model="ir.cron">
        <field name="name">Revisión semanal de partes de horas</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_weekly_timesheets()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_daily_planning_report" model="ir.cron">
        <field name="name">Reporte diario de planificación</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model.send_daily_planning_report()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall">2026-10-14 05:00:00</field>
    </record>
</odoo>
