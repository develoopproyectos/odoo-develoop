<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_task_search_form_extended_custom" model="ir.ui.view">
            <field name="name">project.task.search.form.extended.custom</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_search_form"></field>
            <field name="mode">extension</field>
            <field name="type">search</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='unassigned']" position="after">
                    <separator/>
                    <filter string="No planificado" name="x_is_planned" domain="[('x_is_planned', '=', True)]"/>
                </xpath>
            </field>
        </record>

        <record id="task_kanban_update" model="ir.ui.view">
            <field name="name">task_kanban_update</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="replace" >
                    <field name="name" class="o_task_name" placeholder="Título de tarea..." default_focus="1" modifiers="{&quot;required&quot;: true}"/>
                </xpath>
                <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
                    <page name="planning_custom" string="Planificacion" >
                        <field name="x_planning_slot" nolabel="1" >
                            <list>
                                <field name="resource_id" widget="many2one_avatar_resource" optional="show" readonly="not start_datetime or not end_datetime" context="{'from_planning': True, 'search_view_ref': 'planning.resource_resource_search_view_roles', 'search_default_role_ids': role_id, 'show_job_title': True, 'form_view_ref': 'planning.resource_resource_with_employee_form_view_inherit'}" placeholder="Turno abierto" column_invisible="context.get('planning_slots_to_schedule', False)" on_change="1"/>
                                <field name="role_id" optional="show" context="{'search_default_resource_ids': resource_id}" placeholder="p. ej. bartender" on_change="1"/>
                                <field name="sale_line_id" optional="show" options="{'no_create': True}" on_change="1"/>
                                <field name="sale_line_plannable" column_invisible="True"/>
                                <field name="project_id" optional="show" options="{'no_open': True}" on_change="1"/>
                                <field name="start_datetime" widget="daterange" options="{'end_date_field': 'end_datetime'}" column_invisible="context.get('planning_slots_to_schedule', False)" readonly="sale_line_plannable and not start_datetime and not end_datetime" required="not sale_line_plannable and start_datetime and end_datetime" on_change="1"/>
                                <field name="end_datetime" column_invisible="True" on_change="1"/>
                                <field name="allocated_hours" widget="float_time" sum="Horas asignadas" readonly="1" decoration-danger="allocated_percentage &gt; 100" on_change="1"/>
                                <field name="allocated_percentage" avg="Porcentaje asignado" optional="hide" decoration-danger="allocated_percentage &gt; 100" readonly="1" invisible="resource_type == 'material'" on_change="1"/>
                                <field name="resource_type" column_invisible="True" on_change="1"/>
                            </list>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//field[@name='date_deadline']" position="replace" >
                    <field name="x_is_planning_delay" invisible="1" />
                    <field name="date_deadline" invisible="x_is_planning_delay" class="font-weight-bold text-danger" />
                    <field name="date_deadline" invisible="not x_is_planning_delay" />
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="after">
                    <field name="has_trello" invisible='1'></field>
                    <field name="url_trello" widget="url" invisible="not has_trello"/>
                </xpath>
                
            </field>
        </record>

        <record id="project_task_form_inherited_custom" model="ir.ui.view">
            <field name="name">project.task.form.inherited.custom</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('text-nowrap') and field[@name='allocated_hours']]" position="after">
                    <label for="effective_hours" invisible="not allow_timesheets"/>
                    <div class="text-nowrap" invisible="not allow_timesheets">
                        <field name="effective_hours" class="oe_inline o_field_float_time o_task_planned_hours" widget="timesheet_uom_no_toggle" on_change="1" field_id="allocated_hours_0"/>                        
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_task_kanban_custom" model="ir.ui.view">
            <field name="name">view_task_kanban_custom</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='color']" position="after">
                    <field name="x_planning_slot_str" />
                </xpath>
                <!-- <xpath expr="//div[@name='date_deadline']" position="replace">
                    <div t-if="record.planned_date_end.raw_value" name="planned_date_end" attrs="{'invisible': [('is_closed', '=', True)]}">
                        <field name="planned_date_end" widget="remaining_days"/>
                    </div>
                </xpath> -->
                <!-- <xpath expr="//div[@class='o_kanban_record_body']/div[1]" position="after">
                    <div style="font-size:10px;">
                      <t t-raw="record.x_planning_slot_str.raw_value"/>
                    </div>
                </xpath> -->
                <!-- <field name="x_planning_slot_str" style="font-size:10px;"/> -->
                <!-- <field name="x_planning_slot_str" type="html"/> -->
            </field>
        </record>

        <!-- ACTUALIZA LOS DOMINIOS DE LOS REGISTROS EXISTENTES -->
        <record id="project.act_project_project_2_project_task_all" model="ir.actions.act_window">
                <field name="domain">[('project_id', '=', active_id)]</field>
        </record>
        <record id="project.action_view_task" model="ir.actions.act_window">
                <field name="domain">[('project_id', '=', active_id)]</field>
        </record>
    </data>

</odoo>
