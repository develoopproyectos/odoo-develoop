<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_develoop_custom" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='partner_vat_address_not_same_as_shipping']" position="attributes">
            <attribute name="style">margin-top:-18px;</attribute>
        </xpath>
        <xpath expr="//div[@id='partner_vat_address_same_as_shipping']" position="attributes">
            <attribute name="style">margin-top:-18px;</attribute>
        </xpath>
        <xpath expr="//div[@id='partner_vat_no_shipping']" position="attributes">
            <attribute name="style">margin-top:-18px;</attribute>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span t-if="o.move_type == 'out_refund'">
                    <t name="credit_note_title">Factura Rectificativa</t>
                </span>
                <span t-if="o.move_type != 'out_refund'">
                    <t name="invoice_title">Factura</t>
                </span>
            </t>
		</xpath>
        <xpath expr="//div[@id='informations']" position="replace">
            <div id="informations" class="row mb-4">
                <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date" name="invoice_date">
                    <strong>Fecha factura:</strong>
                    <p class="m-0" t-field="o.invoice_date"/>
                </div>
                <div class="col-auto col-3 mw-100 mb-2" name="reference">
                    <strong>Número Factura:</strong>
                    <p class="m-0" t-field="o.name"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="replace"/>
        <xpath expr="//th[@name='th_priceunit']" position="replace"/>
        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//td[@name='td_quantity']" position="replace"/>
        <xpath expr="//td[@name='td_price_unit']" position="replace"/>
        <xpath expr="//td[@name='td_taxes']" position="replace"/>

        <xpath expr="//div[@id='payment_term']" position="after">
            <!-- <p class="mt-2" t-if="o.team_id.name == 'Mantenimientos'"> -->
            <p class="mt-2">
                <strong>Forma de pago:</strong>
                <span t-field="o.invoice_payment_term_id"/>
            </p>
            <p t-if="o.team_id.name == 'Mantenimientos'">
                <strong>Esta factura cubre el siguiente periodo:</strong>
                <span t-field="o.invoice_date" t-options='{"format": "MM/yyyy"}'/>
                <br/>
            </p>
            <p t-if="o.team_id.name == 'Mantenimientos'">
                <strong>Fecha vencimiento:</strong>
                <span t-field="o.invoice_date_due"/>
            </p>
            <div>
                <p t-if="o.team_id.name == 'ERP'">
                    <strong t-if="o.narration != '&lt;p&gt;&lt;br&gt;&lt;/p&gt;'">Notas:</strong>
                    <br/>
                    <span t-field="o.narration"/>
                    <br/>
                </p>
                <p t-if="o.team_id.name == 'Software a medida'">
                    <strong t-if="o.narration != '&lt;p&gt;&lt;br&gt;&lt;/p&gt;'">Notas:</strong>
                    <br/>
                    <span t-field="o.narration"/>
                    <br/>
                </p>
                <p t-if="o.team_id.name == 'SERVICIOS'">
                    <strong t-if="o.narration != '&lt;p&gt;&lt;br&gt;&lt;/p&gt;'">Notas:</strong>
                    <br/>
                    <span t-field="o.narration"/>
                    <br/>
                </p>
            </div>
        </xpath>

        <xpath expr="//div[p[@name='note']]" position="replace"/>
        <xpath expr="//div[p[@name='taxes_legal_notes']]" position="replace"/>
        <xpath expr="//p[@name='payment_communication']" position="replace">
            <p name="payment_communication">
                <t t-if="o.partner_bank_id">
                </t>
            </p>
        </xpath>
        <xpath expr="//div[span[@id='payment_terms_note_id']]" position="replace"/>
        <xpath expr="//div[@t-if='not is_html_empty(o.narration)']" position="replace"/> 
        <xpath expr="//p[@t-if='o.payment_mode_id.note']" position="replace"/>
        <xpath expr="//p[@t-as='partner_bank']" position="replace"/>

    </template>

    <template id="document_tax_totals_template_inherit" inherit_id="account.document_tax_totals_template">
        <xpath expr="//tr[hasclass('o_subtotal')]/td" position="replace">
            <td><strong>Importe libre de impuestos</strong></td>
        </xpath>
        
    </template>
</odoo>