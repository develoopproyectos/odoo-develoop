<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="planning_slot_view_form_custom" model="ir.ui.view">
        <field name="name">planning.slot.form.custom</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//field[@name='allocated_hours']" position="after">
                <field name="x_expiration_date" string="Fecha límite" />
            </xpath> -->
            <xpath expr="//field[@name='role_id']" position="before">
                <!-- <field name="planned_date_end" invisible='1'/> -->
                <field name="resource_ids" string="Recursos" widget="many2many_tags" readonly="id != False" />
                <field name="x_resourse_plannable_hours" invisible='1'/>
            </xpath>
        </field>
    </record>



    <record id="planning_view_gantt_custom" model="ir.ui.view">
        <field name="name">planning.slot.gantt</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_gantt"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allocated_hours']" position="after">
                <!-- <field name="x_expiration_date" />
                <field name="x_kanban_state" />
                <field name="x_stage_id" />
                <field name="planned_date_end" invisible='1'/> -->
                <field name="x_resourse_plannable_hours" invisible='1'/>
            </xpath>
        </field>
    </record>


    <record id="planning_forecast_inherit" model="ir.ui.view">
        <field name="name">planning.slot.custom.view.form</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="project_forecast.planning_slot_view_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='project_id'][2]" position="after">  
                    <field name="user_ids" invisible="1"/>
                    <field name="task_id" context="{'default_project_id': project_id,'default_user_ids': user_ids}"/>
                    <field name="task_id" readonly="True" groups="planning.group_planning_manager"/>
                </xpath>
            </data>
        </field>
    </record>

    <!-- <record id="planning_view_form_in_gantt_custom" model="ir.ui.view">
        <field name="name">planning.view.form.in.gantt.custom</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form_in_gantt"/>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="replace"/>
        </field>
    </record> -->

    <record id="planning_slot_view_form_inherit" model="ir.ui.view">
        <field name="name">planning.slot.form.inherit</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form_in_gantt"/>
        <field name="arch" type="xml">
           <xpath expr="//footer/button[@name='action_send']" position="after">
                <button string="Publicar" type="object" name="action_publish" class="btn btn-primary" close="1"
                        groups="planning.group_planning_manager" 
                        invisible="context.get('my_planning_action') or (state == 'published' or resource_type == 'material')"/>
            </xpath>
        </field>
    </record>
</odoo>