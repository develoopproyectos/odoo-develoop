<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_develoop_custom" model="ir.ui.view">
        <field name="name">view.order.form.develoop.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_mode_id']" position="after">
                <field name="monthly_billing" widget="monetary"/>
                <field name="billing_advance" widget="monetary"/>
            </xpath>
        </field>
    </record>
    <record id="view_sales_order_filter_develoop_custom" model="ir.ui.view">
        <field name="name">view.sales.order.filter.develoop.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_type_id']" position="after">
                <field name="monthly_billing"/>
                <field name="billing_advance"/>
            </xpath>
        </field>
    </record>
</odoo>