<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
    
        <!-- Aviso amistoso del martes -->
        <record id="mail_template_timesheet_reminder" model="mail.template">
            <field name="name">Aviso del Martes (Recordatorio Amistoso)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">Recordatorio: Revisión de fichajes y parte de horas de la semana pasada</field>
            <field name="email_to">{{ object.work_email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hola <t t-out="object.name"/>,</p>

                    <p>
                        Revisando los registros de la semana pasada, hemos detectado un descuadre en tus registros
                        <span>
                            (días pendientes:
                            <t t-out="len(ctx.get('Dias_Faltantes', []))"/>)
                        </span>.
                        Esto puede ocurrir por dos motivos: o bien te has olvidado de imputar horas en tu parte de trabajo, 
                        o bien las horas de tu fichaje de asistencia no coinciden con las horas imputadas. Recuerda que es muy importante 
                        que ambos registros cuadren y tengan la misma cantidad de horas.
                    </p>
                    <p>Por favor, cuando tengas un momento a lo largo del día de hoy, revisa y completa tus registros para llevarlo todo al día.</p>
                    <p>¡Muchas gracias y a por el martes!</p>

                    <p>
                        <strong>Semana revisada:</strong>
                        <t t-out="ctx.get('Semana_Anterior')"/>
                    </p>

                    <table border="1" cellpadding="5" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Horas de asistencia</th>
                                <th>Horas imputadas</th>
                                <th>Horas pendientes</th>
                                <th>Horas en exceso</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="ctx.get('Dias_Faltantes', [])" t-as="day">
                                <td><t t-out="day['fecha']"/></td>
                                <td><t t-out="day['horas_asistencia_display']"/></td>
                                <td><t t-out="day['horas_imputadas_display']"/></td>
                                <td><t t-out="day['horas_pendientes_display']"/></td>
                                <td><t t-out="day['horas_exceso_display']"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
        </record>

        <!-- Recordatorio urgente del viernes -->
        <record id="mail_template_timesheet_urgent" model="mail.template">
            <field name="name">Aviso del Viernes (Recordatorio Directo y Urgente)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">Asunto: IMPORTANTE: Regularización urgente de tu parte de horas y fichajes</field>
            <field name="email_to">{{ object.work_email }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Hola <t t-out="object.name"/>,</p>

                    <p>
                        Llegamos a final de semana y seguimos detectando descuadres en tus registros de la semana pasada en los siguientes días: <strong>(<t t-out="len(ctx.get('Dias_Faltantes', []))"/>)</strong>
                    </p>
                    <p>
                        Te recordamos que las horas de asistencia (tu fichaje) y las horas imputadas en tu parte de trabajo tienen que ser exactamente iguales.
                    </p>
                    <p>
                        Es <strong>estrictamente necesario e imprescindible</strong> que dejes esto resuelto hoy mismo. 
                        Tener diferencias entre el fichaje y el parte de horas, o dejar días sin imputar, bloquea los cierres de facturación y el correcto seguimiento de los proyectos.
                    </p>
                    <p>
                        Por favor, paraliza lo que estés haciendo y actualízalo inmediatamente para que ambos registros coincidan. Gracias.
                    </p>
                    <p>
                        <strong>Semana revisada:</strong>
                        <t t-out="ctx.get('Semana_Anterior')"/>
                    </p>

                    <table border="1" cellpadding="5" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Horas de asistencia</th>
                                <th>Horas imputadas</th>
                                <th>Horas pendientes</th>
                                <th>Horas en exceso</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="ctx.get('Dias_Faltantes', [])" t-as="day">
                                <td><t t-out="day['fecha']"/></td>
                                <td><t t-out="day['horas_asistencia_display']"/></td>
                                <td><t t-out="day['horas_imputadas_display']"/></td>
                                <td><t t-out="day['horas_pendientes_display']"/></td>
                                <td><t t-out="day['horas_exceso_display']"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </field>
        </record>

        <record id="mail_template_daily_planning_report" model="mail.template">
            <field name="name">Reporte Diario de Planificación</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">Reporte Diario de Planificación Corto Plazo - {{ ctx.get('report_data', {}).get('today', '') }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Hola equipo,</p>
                    <p>
                        A continuación os comparto el estado de la planificación
                        para el día de hoy y el próximo día laborable.
                        Por favor, revisad los casos con horas pendientes de
                        asignar o excedidas.
                    </p>

                    <h3>
                        HOY (
                            <t t-if="ctx.get('report_data', {}).get('today')"
                            t-out="ctx.get('report_data', {}).get('today').strftime('%d/%m/%Y')"/>
                        )
                    </h3>
                    <t t-foreach="ctx.get('report_data', {}).get('today_lines', [])"
                    t-as="line">
                        <p>
                            <t t-out="line['status']"/>
                            <t t-out="line['description']"/> -
                            <t t-out="line['name']"/>:
                            <t t-out="'%.2f' % line['hours']"/>h
                        </p>
                    </t>

                    <h3>
                        PRÓXIMO DÍA LABORABLE (
                            <t t-if="ctx.get('report_data', {}).get('tomorrow')"
                            t-out="ctx.get('report_data', {}).get('tomorrow').strftime('%d/%m/%Y')"/>
                        )
                    </h3>
                    <t t-foreach="ctx.get('report_data', {}).get('tomorrow_lines', [])"
                    t-as="line">
                        <p>
                            <t t-out="line['status']"/>
                            <t t-out="line['description']"/> -
                            <t t-out="line['name']"/>:
                            <t t-out="'%.2f' % line['hours']"/>h
                        </p>
                    </t>

                    <p>Un saludo,</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
