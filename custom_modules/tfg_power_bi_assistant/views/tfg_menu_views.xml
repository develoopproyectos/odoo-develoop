<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- DASHBOARD ACTION -->
    <record id="tfg_dashboard_action_view" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">tfg.dashboard</field>            
        <field name="help" type="html">
            <t t-name="tfg_dashboard_template">
                <t t-call="web.layout">
                    <t t-set="title">Dashboard</t>
                    <div class="o_container">
                        <h1>Hello from the Dashboard!</h1>
                    </div>
                </t>
            </t>
        </field>
    </record>
    <!-- MAIN MENU ITEM GOIN TO DASHBOARD -->
    <menuitem
        id="tfg_main_menu"
        name="BI Assistant"
        action="tfg_dashboard_action_view"   
        web_icon="fa fa-bar-chart-o,#f1c40f,#34495e"             
        sequence="10"/>

    <menuitem
        id="tfg_dashboard_menu"
        name="Dashboard"
        action="tfg_dashboard_action_view"
        parent="tfg_main_menu"                
        sequence="2"/>

    <!-- CHAT ACTION -->
    <record id="tfg_chat_action_view" model="ir.actions.act_window">
        <field name="name">Chat</field>
        <field name="res_model">tfg.chat</field>        
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Welcome to the Dashboard! Start by creating your first record.
            </p>
        </field>
    </record>
    <!-- MAIN MENU ITEM GOIN TO CHAT -->
    <menuitem
        id="tfg_chat_menu"
        name="Chat"
        action="tfg_chat_action_view"         
        parent="tfg_main_menu"
        sequence="5"/>

    <!-- REPORT ACTION -->

    <record id="tfg_report_action_view" model="ir.actions.act_window">
        <field name="name">Business Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tfg.report</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Tfg Report.
            </p>
        </field>
    </record>
    <!-- MENU ITEM GOIN TO REPORTS -->
    <menuitem
        id="tfg_report_menu"
        name="Business Report"
        action="tfg_report_action_view"        
        parent="tfg_main_menu"
        sequence="10"/>
</odoo>