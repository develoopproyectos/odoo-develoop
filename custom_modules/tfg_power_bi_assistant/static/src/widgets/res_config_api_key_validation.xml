<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div t-name='res_config_api_key_validation'>
        <p class="o_form_label">Enter AI Service API Key</p>

        <div class="d-flex">                        
            <input t-att-value="props.record.data.ai_service_api_key" t-att-disabled="state.status != 'idle'" class="o_input mt8 text-truncate" type="text" placeholder="Enter AI API Key" t-on-input="onInputChange"/>
            <button t-att-disabled="state.status != 'idle'" class="btn btn-primary o_web_settings_invite flex-shrink-0" t-on-click="ValidateAIService"><strong><t t-esc="validateButtonText"/></strong></button>
        </div>        
    </div>
</templates>
