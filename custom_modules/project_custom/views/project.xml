<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_new_fields_custom" model="ir.ui.view">
        <field name="name">project_new_fields_custom</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='settings']/group[1]" position="after">
                <group>
                    <group>
                        <field name="x_theoretical_start_date" />
                        <field name="x_theoretical_end_date" />
                        <field name="x_estimated_end_date" />
                    </group>
                    <group>
                        <field name="x_kanban_state" widget="state_selection" class="ml-auto"/>
                        <field name="x_phase" />
                        <field name="x_technology" widget="many2many_tags" />
                    </group>
                </group>
            </xpath>
            <xpath expr="//div[hasclass('o_settings_container')]" position="inside">
                <div class="col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="has_trello"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="has_trello"/>
                        <div class="text-muted" id="has_trello_setting">
                            Permite indicar los enlaces de las tareas de Trello
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="url_trello" widget="url" attrs="{'invisible': [('has_trello','=', False)]}"></field>
            </xpath>
        </field>
    </record>   

</odoo>