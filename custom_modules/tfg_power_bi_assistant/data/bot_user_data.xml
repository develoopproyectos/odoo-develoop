<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        
        <!-- Crear el partner vinculado al usuario -->
        <record id="tfg_user_partner" model="res.partner">
            <field name="name">IA Assistance User</field>
            <field name="email">tfg_ia_user@api.com</field>
        </record>

        <!-- Crear el usuario -->
        <record id="tfg_user" model="res.users">
            <field name="name">IA Assistance User</field>
            <field name="login">tfg_ia_user@api.com</field>
            <field name="password">admin</field> <!-- Change on PRE o PROD-->
            <field name="partner_id" ref="tfg_user_partner"/>
            <field name="groups_id" eval="[(4, ref('base.group_user')),(4, ref('base.group_system')),(4, ref('base.group_erp_manager')),(4, ref('account.group_account_manager'))]"/>
        </record>
    
    </data>
</odoo>