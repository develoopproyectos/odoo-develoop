<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View planning.slot.log View Tree -->
    <record id="view_planning_slot_log_tree" model="ir.ui.view">
        <field name="name">view.planning.slot.log.tree</field>
        <field name="model">planning.slot.log</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false">
                <field name="log_date"/>
                <field name="partner_id" widget="many2one_avatar_user"/>
                <field name="project_id" readonly="1"/>
                <field name="task_id" />
                <field name="resource_id" widget="many2one_avatar_user"/>
                <field name="action" widget="badge" 
                    decoration-success="action == 'created'"
                    decoration-danger="action == 'removed'"
                    decoration-warning="action == 'modified'"/>
                <field name="new_start_date" widget="daterange"
                    options="{'end_date_field': 'new_end_date'}"/>
                <field name="old_start_date" widget="daterange"
                    options="{'end_date_field': 'old_end_date'}"/>
                
            </tree>
        </field>
    </record>

    <!-- View planning.slot.log form -->
    <record id="view_planning_slot_log_form" model="ir.ui.view">
        <field name="name">view.planning.slot.log.form</field>
        <field name="model">planning.slot.log</field>
        <field name="arch" type="xml">
            <form string="Registro de Cambio en Planificación" create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="log_date" readonly="1"/>
                            <field name="partner_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="task_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="resource_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="action" readonly="1"/>
                            <field name="new_start_date" widget="daterange"
                                options="{'end_date_field': 'new_end_date'}" readonly="1"/>
                            <field name="old_start_date" widget="daterange"
                                options="{'end_date_field': 'old_end_date'}" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View planning.slot.log search -->
    <record id="view_planning_slot_log_search" model="ir.ui.view">
        <field name="name">view.planning.slot.log.search</field>
        <field name="model">planning.slot.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="resource_id"/>
                <field name="action"/>
                <filter string="Fecha de Planificacíon" name="new_start_date" date="new_start_date" />
                <filter string="Fecha de Planificacíon Anterior" name="old_start_date" date="old_start_date" />
                <filter
                    string="Creados"
                    name="created"
                    domain="[('action','=', 'created')]"
                />
                <filter
                    string="Modificados"
                    name="modified"
                    domain="[('action','=', 'modified')]"
                />
                <filter
                    string="Eliminados"
                    name="removed"
                    domain="[('action','=', 'removed')]"
                />
                <separator/>
                <group expand="1" string="Agrupar por">
                    <filter string="Responsable" name="partner_id" domain="[]" context="{'group_by':'partner_id'}"/>
                    <filter string="Proyecto" name="project_id" domain="[]" context="{'group_by':'project_id'}"/>
                    <filter string="Tarea" name="task_id" domain="[]" context="{'group_by':'task_id'}"/>
                    <filter string="Recurso" name="resource_id" domain="[]" context="{'group_by':'resource_id'}"/>
                    <filter string="Acción" name="action" domain="[]" context="{'group_by':'action'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action planning.slot.log -->
    <record id="action_planning_slot_log" model="ir.actions.act_window">
        <field name="name">Historial de cambios en Planificación</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">planning.slot.log</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Planning Slot Log.
            </p>
        </field>
    </record>

    <menuitem id="planning_changes_history" parent="planning.planning_menu_reporting" name="Historial de cambios" action="action_planning_slot_log" sequence="11" />

</odoo>