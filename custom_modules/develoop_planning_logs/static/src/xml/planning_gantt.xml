<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web_gantt.GanttRenderer.RowContent" t-inherit-mode="extension">

        <xpath expr="//div[hasclass('o_gantt_cell')]" position="attributes">

            <attribute name="t-on-click.synthetic">
                (ev) => this.onPlanningCellClicked(row, column)
            </attribute>

            <attribute name="t-on-mouseenter">
                (ev) => this.onPlanningCellMouseEnter(ev, row, column)
            </attribute>

            <attribute name="t-on-mouseleave">
                (ev) => this.onPlanningCellMouseLeave(ev)
            </attribute>

        </xpath>

    </t>

</templates>